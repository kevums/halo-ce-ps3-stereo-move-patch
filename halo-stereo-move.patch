+    ps3_video_present_size(&dw,&dh);
+    if (!mode) { if(width && height)blit_draw(offset,pitch,width,height); return; }
+    ps3_video_clear(0xff000000);
+    for(eye=0;eye<2;eye++) {
+        if (mode==4 && eye) {ps3_video_end_frame();ps3_video_begin_frame();ps3_video_clear(0xff000000);}
+        extension_blit=1;
+        extension_rect[0]=mode==1 ? eye*(dw/2) : 0;
+        extension_rect[1]=mode==2 ? eye*(dh/2) : mode==3 ? eye*750 : 0;
+        extension_rect[2]=mode==1 ? dw/2 : dw;
+        extension_rect[3]=mode==2 ? dh/2 : mode==3 ? 720 : dh;
+        if(extension_eyes[eye].memory)blit_draw(extension_eyes[eye].offset,extension_eyes[eye].pitch,
+            extension_eyes[eye].width,extension_eyes[eye].height);
+        else if(width && height)blit_draw(offset,pitch,width,height);
+        extension_blit=0;
+    }
+}
