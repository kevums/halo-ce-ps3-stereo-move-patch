 /* ---------- private code */
+
+/* Public frame entry: both eyes see exactly the same simulation/interpolation time.
+ * Keep stock cameras intact, including multiplayer window rectangles. */
+void render_frame(struct render_window *windows, short count,
+    const point2d *page, const point2d *index, struct bitmap_data *bitmap, real delta)
+{
+#ifdef HALO_PS3
+    int eye, i;
+    struct render_window freeaim_windows[4];
+    if (count>0 && count<=4) {
+        memcpy(freeaim_windows,windows,count*sizeof(windows[0]));
+        windows=freeaim_windows;
+        for(i=0;i<count;i++) if(windows[i].local_player_index==0) {
+            extern void halo_move_camera(float *,float *,float,float);
+            struct render_camera *c[2]={&windows[i].render_camera,&windows[i].rasterizer_camera};
+            int j;
+            for(j=0;j<2;j++) halo_move_camera(&c[j]->forward.i,&c[j]->up.i,c[j]->vertical_field_of_view,
+                (float)(c[j]->viewport_bounds.x1-c[j]->viewport_bounds.x0)/
+                MAX(1,c[j]->viewport_bounds.y1-c[j]->viewport_bounds.y0));
+        }
+    }
+    struct render_window copies[4];
+    if (halo_ext_stereo_mode() && count > 0 && count <= 4 && !index && !bitmap) {
+        for (eye = 0; eye < 2; eye++) {
+            extension_eye = (eye == 0 ? -1 : 1) * (halo_ext_value("r_stereo_swap") ? -1 : 1);
+            memcpy(copies, windows, count * sizeof(copies[0]));
+            for (i = 0; i < count; i++) {
+                struct render_camera *cameras[2] = {&copies[i].render_camera, &copies[i].rasterizer_camera};
+                int c;
+                if (copies[i].local_player_index == NONE) continue;
+                for (c = 0; c < 2; c++) {
+                    real_vector3d right;
+                    real distance = extension_eye * halo_ext_value("r_stereo_depth") * 0.0325f;
+                    cross_product3d(&cameras[c]->forward, &cameras[c]->up, &right);
+                    cameras[c]->position.x += right.i * distance;
+                    cameras[c]->position.y += right.j * distance;
+                    cameras[c]->position.z += right.k * distance;
+                }
+            }
+            extension_render_frame(copies, count, page, index, bitmap, delta);
+            d3d8_extension_capture(eye);
+        }
+        extension_eye = 0;
+        return;
+    }
+#endif
+    extension_render_frame(windows, count, page, index, bitmap, delta);
+}
