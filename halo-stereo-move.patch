+void halo_gpu_capture_eye(int eye, uint32_t offset, uint32_t pitch, uint32_t width, uint32_t height)
+{
+    uint32_t bytes;
+    if (eye<0 || eye>1 || !width || !height) return;
+    bytes=width*height*4;
+    if (!extension_eyes[eye].memory || extension_eyes[eye].bytes!=bytes) {
+        if (extension_eyes[eye].memory) ps3_gpu_memory_free(extension_eyes[eye].memory,
+            extension_eyes[eye].bytes,_ps3_gpu_memory_target);
+        extension_eyes[eye].memory=ps3_gpu_memory_allocate(bytes,128,_ps3_gpu_memory_target,&extension_eyes[eye].offset);
+        extension_eyes[eye].bytes=bytes;
+    }
+    if (!extension_eyes[eye].memory) return;
+    extension_eyes[eye].pitch=width*4;
+    extension_eyes[eye].width=width;extension_eyes[eye].height=height;
+    /* Do not let the transfer engine read a render target before its 3D draws finish. */
+    {
