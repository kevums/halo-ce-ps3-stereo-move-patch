+EXT_SETTING("move_enable", "0", "enable PS Move wand input (restart required)")
+EXT_SETTING("move_blue_orb", "0", "Blue orb while Move is in use; preserve optical tracking")
+EXT_SETTING("move_sensitivity", "1.5", "view degrees per degree of Move rotation")
+EXT_SETTING("move_freeaim_turn_button", "0", "independent aim turn button: 0 mapped clutch, 1 T, 2 X, 3 Square, 4 Circle, 5 Triangle, 6 Start, 7 Select, 8 Move")
+EXT_SETTING("move_freeaim_invert", "1", "independent aim: release to turn, hold to lock camera and aim reticle")
+EXT_SETTING("move_freeaim_turn_gain", "5.5", "independent camera turn multiplier, 0.5 to 12; fine aim is unchanged")
+EXT_SETTING("move_deadzone", "0.0500000007", "Move gyro drift deadzone in radians/sec")
+EXT_SETTING("move_invert_y", "0", "invert Move pitch")
+EXT_SETTING("move_nav", "1", "use Navigation button layout with a connected Move")
